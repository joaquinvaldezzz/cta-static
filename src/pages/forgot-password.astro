---
import Layout from '~/layouts/Layout.astro'
import KeyIcon from '~/snippets/icon-key.astro'
---

<Layout title="Forgot password">
  <div class="container py-4 md:py-8">
    <a href="#recover">Forgot password?</a>
  </div>

  <div
    class="absolute inset-0 hidden bg-overlay-bg/70 px-4 py-12 shadow-xl backdrop-blur-md md:pt-24"
    id="recover"
  >
    <div
      class="relative mx-auto flex max-w-sm flex-col gap-8 rounded-lg bg-white px-4 pb-4 pt-5 md:p-6"
    >
      <button
        class="absolute right-3 top-3 h-11 w-11 rounded text-quinary-fg transition hover:text-quinary-fg-hover focus:outline-none focus:ring-4 focus:ring-light-400/10"
        id="close-button"
        type="button"
      >
        <svg
          class="m-auto h-6 w-6"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>

      <div class="flex flex-col items-center gap-6">
        <div
          class="flex h-14 w-14 items-center justify-center rounded-xl border border-light-200 shadow-xs"
        >
          <KeyIcon className="h-7 w-7 text-secondary-fg " />
        </div>

        <div class="flex flex-col gap-1 text-center">
          <h1 class="font-semibold text-primary md:text-lg">Forgot password?</h1>
          <p class="text-tertiary">No worries, we'll send you reset instructions.</p>
        </div>
      </div>

      <div class="flex flex-col gap-8">
        <form class="flex flex-col gap-6" action="">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-medium text-secondary" for="email-address">
              Email address
            </label>
            <input
              class="rounded border border-primary-border bg-primary-bg px-3.5 py-2.5 text-primary shadow-xs transition placeholder:text-placeholder focus:border-brand-border focus:outline-none focus:ring-4 focus:ring-brand-600/25"
              id="email-address"
              type="email"
              placeholder="Enter your email address"
            />
          </div>

          <div class="flex flex-col gap-3">
            <button
              class="rounded border bg-button-primary-bg px-4 py-2.5 font-semibold text-button-primary-fg transition hover:bg-button-primary-bg-hover focus:border-button-primary-border focus:outline-none focus:ring-4 focus:ring-brand-600/25"
              type="submit"
            >
              Reset password
            </button>

            <a
              class="rounded border border-button-secondary-border bg-button-secondary-bg px-4 py-2.5 text-center font-semibold text-button-secondary-fg shadow-xs transition hover:bg-button-secondary-bg-hover focus:border-button-secondary-border focus:outline-none focus:ring-4 focus:ring-light-400/10"
              href="#"
            >
              Back to log in
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="../scripts/forgot-password-modal.js"></script>
</Layout>
