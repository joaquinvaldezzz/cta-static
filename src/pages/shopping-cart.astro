---
import Layout from '~/layouts/Layout.astro'
---

<Layout title="Shopping cart">
  <div class="mt-header py-16 lg:py-24">
    <div class="mx-auto max-w-screen-xl px-4 md:px-8">
      <div class="flex max-w-screen-md flex-col gap-8">
        <div class="flex flex-col gap-4 lg:gap-6">
          <div class="flex flex-col gap-3">
            <p class="text-sm font-semibold text-brand-secondary lg:text-md">Shopping cart</p>
            <h1 class="font-display text-display-md font-semibold text-primary lg:text-display-lg">
              Your bag total is $99.99.
            </h1>
          </div>
          <p class="text-lg text-tertiary lg:text-xl">
            Lorem ipsum dolor sit amet consectetur. Sagittis id tortor eu vitae tempor morbi.
          </p>
        </div>

        <div class="flex flex-col md:flex-row">
          <a
            class="rounded border bg-button-primary-bg px-4.5 py-3 text-center font-semibold text-button-primary-fg transition hover:bg-button-primary-bg-hover focus:border-button-primary-border focus:outline-none focus:ring-4 focus:ring-brand-600/25"
            href="#"
          >
            Check out
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="pb-16 lg:pb-24">
    <div class="mx-auto max-w-screen-xl px-4 md:px-8">
      <form class="flex flex-col gap-8">
        <div>
          <ul class="max-w-screen-lg border-b border-b-secondary-border">
            <li class="flex flex-col gap-4 border-t border-t-secondary-border py-8 lg:flex-row">
              <div class="flex flex-col gap-4 lg:w-[35rem] lg:flex-row lg:items-center">
                <div class="h-80 lg:h-40 lg:w-40">
                  <img
                    class="h-full w-full rounded object-cover lg:rounded-lg"
                    src="/images/jake-forsher-4-HydgF5dM8-unsplash.jpg"
                    alt="A man holding a gun"
                  />
                </div>

                <div class="flex flex-col gap-1">
                  <h3 class="font-display text-display-xs font-semibold text-primary">
                    Product name
                  </h3>
                  <div class="text-secondary">Lorem ipsum dolor sit</div>
                </div>
              </div>
            </li>
          </ul>
        </div>

        <div class="flex max-w-screen-lg flex-col gap-8 py-8">
          <div>
            <div class="flex items-center justify-between py-2">
              <div class="text-xl font-semibold text-secondary">Subtotal</div>
              <div class="text-xl font-semibold text-primary">$99.99</div>
            </div>

            <div class="flex items-center justify-between border-b border-b-secondary-border py-2">
              <div class="text-xl font-semibold text-secondary">Tax</div>
              <div class="text-xl font-semibold text-primary">$99.99</div>
            </div>

            <div class="flex items-center justify-between py-4">
              <div class="text-display-sm font-semibold text-secondary">Total</div>
              <div class="text-display-sm font-semibold text-primary">$99.99</div>
            </div>
          </div>

          <div class="flex flex-col md:flex-row md:justify-end">
            <a
              class="rounded border bg-button-primary-bg px-4.5 py-3 text-center font-semibold text-button-primary-fg transition hover:bg-button-primary-bg-hover focus:border-button-primary-border focus:outline-none focus:ring-4 focus:ring-brand-600/25"
              href="#"
            >
              Check out
            </a>
          </div>
        </div>
      </form>
    </div>
  </div>
</Layout>
