---
import Layout from '~/layouts/Layout.astro'
---

<Layout title="Shopping cart">
  <div class="mt-[--header-height] py-16 lg:py-24">
    <div class="mx-auto max-w-screen-xl px-4 md:px-8">
      <div class="flex max-w-screen-md flex-col gap-8">
        <div class="flex flex-col gap-4 lg:gap-6">
          <div class="flex flex-col gap-3">
            <p class="text-sm font-semibold text-brand-700 dark:text-dark-300 lg:text-md">
              Shopping cart
            </p>
            <h1
              class="font-display text-display-md font-semibold dark:text-dark-50 lg:text-display-lg"
            >
              Your bag total is $99.99.
            </h1>
          </div>
          <p class="text-lg text-light-600 dark:text-dark-400 lg:text-xl">
            Lorem ipsum dolor sit amet consectetur. Sagittis id tortor eu vitae tempor morbi.
          </p>
        </div>

        <div class="flex flex-col md:flex-row">
          <a class="rounded bg-brand-600 px-4.5 py-3 text-center font-semibold text-white" href="#">
            Check out
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="pb-16 lg:pb-24">
    <div class="mx-auto max-w-screen-xl px-4 md:px-8">
      <form class="flex flex-col gap-8">
        <div>
          <ul class="max-w-screen-lg border-b dark:border-b-dark-800">
            {
              [...Array(6).keys()].map((i) => (
                <li class="flex flex-col gap-4 border-t py-8 dark:border-t-dark-800 lg:flex-row">
                  <div class="flex flex-col gap-4 lg:w-[35rem] lg:flex-row lg:items-center">
                    <div class="h-80 lg:h-40 lg:w-40">
                      <img
                        class="h-full w-full rounded object-cover lg:rounded-lg"
                        src="/images/jake-forsher-4-HydgF5dM8-unsplash.jpg"
                        alt="A man holding a gun"
                      />
                    </div>

                    <div class="flex flex-col gap-1">
                      <h3 class="font-display text-display-xs font-semibold dark:text-dark-50">
                        Lorem ipsum dolor sit
                      </h3>
                      <div class="dark:text-dark-300">Lorem ipsum dolor sit</div>
                    </div>
                  </div>

                  <div class="flex items-center justify-between lg:flex-1">
                    <select
                      class="form-select cursor-pointer rounded border bg-transparent dark:border-dark-700 dark:text-dark-50"
                      id={`product-${i + 1}`}
                      name={`product-${i + 1}`}
                    >
                      {Array.from({ length: 10 }, (_, i) => (
                        <option value={i + 1}>{i + 1}</option>
                      ))}
                    </select>

                    <div class="text-xl font-semibold dark:text-dark-50">$249.00</div>

                    <div class="flex items-center gap-3">
                      <button class="h-8 dark:text-dark-400" type="button">
                        Edit
                      </button>
                      <button class="h-8 dark:text-dark-400" type="button">
                        Delete
                      </button>
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex max-w-screen-lg flex-col gap-8 py-8">
          <div>
            <div class="flex items-center justify-between py-2">
              <div class="text-xl font-semibold dark:text-dark-300">Subtotal</div>
              <div class="text-xl font-semibold dark:text-dark-300">$99.99</div>
            </div>

            <div class="flex items-center justify-between border-b py-2 dark:border-b-dark-800">
              <div class="text-xl font-semibold dark:text-dark-300">Taxs</div>
              <div class="text-xl font-semibold dark:text-dark-300">$99.99</div>
            </div>

            <div class="flex items-center justify-between py-4">
              <div class="text-display-sm font-semibold dark:text-dark-50">Total</div>
              <div class="text-display-sm font-semibold dark:text-dark-50">$99.99</div>
            </div>
          </div>

          <div class="flex flex-col md:flex-row md:justify-end">
            <a
              class="rounded bg-brand-600 px-4.5 py-3 text-center font-semibold text-white"
              href="#"
            >
              Check out
            </a>
          </div>
        </div>
      </form>
    </div>
  </div>
</Layout>
