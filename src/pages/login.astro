---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Log in">
  <div class="flex flex-col gap-8 overflow-x-hidden px-4 pb-12 pt-32 md:px-8 lg:pt-44">
    <div class="mx-auto flex w-full flex-col gap-8 md:max-w-[360px]">
      <div class="flex flex-col gap-6 text-center">
        <div class="relative z-0">
          <!-- <img
            class="relative mx-auto h-12 w-12"
            src=""
            alt=""
            loading="lazy"
            width="48"
            height="48"
          /> -->
        </div>

        <div class="relative z-10 flex flex-col gap-2 md:gap-3">
          <h1 class="font-display text-display-xs font-semibold text-primary md:text-display-sm">
            Log in
          </h1>
          <p class="text-tertiary">Welcome back! Please enter your details.</p>
        </div>
      </div>

      <form class="flex flex-col gap-6" action="">
        <ul class="errors">
          <li>Incorrect email or password.</li>
        </ul>

        <div class="flex flex-col gap-5">
          <div class="flex flex-col gap-1.5 lg:flex-1">
            <label class="text-sm font-medium text-secondary" for="email-address">
              Email address
            </label>
            <input
              class="rounded border border-primary-border bg-primary-bg px-3.5 py-2.5 text-primary shadow-xs transition focus:border-brand-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 data-error:border-error-border data-error:ring-error-500/25"
              id="email-address"
              name="customer[email]"
              data-error="true"
              type="email"
              placeholder="Enter your email address"
            />
          </div>
          <div class="flex flex-col gap-1.5 lg:flex-1">
            <label class="text-sm font-medium text-secondary" for="password">Password</label>
            <input
              class="rounded border border-primary-border bg-primary-bg px-3.5 py-2.5 text-primary shadow-xs transition focus:border-brand-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 data-error:border-error-border data-error:ring-error-500/25"
              id="password"
              name="customer[password]"
              type="password"
              placeholder="Enter your password"
            />
          </div>
        </div>

        <button
          class="rounded border bg-button-primary-bg px-4 py-2.5 font-semibold text-button-primary-fg transition hover:bg-button-primary-bg-hover focus:border-button-primary-border focus:outline-none focus:ring-4 focus:ring-brand-600/25"
          type="submit"
        >
          Log in
        </button>
      </form>

      <div class="flex flex-col items-center gap-3">
        <div class="flex justify-center gap-1">
          <p class="text-sm text-tertiary">Don't have an account?</p>
          <a class="text-sm font-semibold text-button-tertiary-color-fg" href="">
            Create an account
          </a>
        </div>

        <a class="text-sm font-semibold text-button-tertiary-color-fg" href="#">
          Forgot password?
        </a>
      </div>
    </div>
  </div>
</Layout>
