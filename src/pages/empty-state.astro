---
import Layout from '~/layouts/Layout.astro'
---

<Layout title="Empty state">
  <div class="mt-header py-16 md:py-24">
    <div class="container flex flex-col items-center gap-4">
      <div
        class="flex h-12 w-12 items-center justify-center rounded-[0.625rem] border border-light-200 shadow-xs"
      >
        <svg
          class="h-6 w-6 text-secondary-fg"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 25 24"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21.5 21 18 17.5m2.5-6a8.5 8.5 0 1 1-17 0 8.5 8.5 0 0 1 17 0Z"></path>
        </svg>
      </div>

      <div class="flex flex-col gap-1 text-center">
        <h1 class="font-semibold text-primary">No products found</h1>
        <p class="text-sm text-tertiary">
          There are no products available right now. Please come back later.
        </p>
      </div>
    </div>
  </div>
</Layout>
