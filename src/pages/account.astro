---
import Layout from '~/layouts/Layout.astro'
---

<Layout title="Account">
  <div class="mt-header overflow-x-hidden py-12 md:pt-24">
    <div class="flex flex-col gap-8 px-4 sm:mx-auto sm:max-w-[30rem] sm:px-0">
      <main class="relative flex flex-col gap-8">
        <form class="flex flex-col gap-6" action="">
          <div class="flex flex-col gap-6 lg:flex-row lg:gap-8">
            <div class="flex flex-col gap-1.5 lg:flex-1">
              <label
                class="text-sm font-medium text-secondary dark:text-secondary-dark"
                for="first-name"
              >
                First name
              </label>
              <input
                class="rounded border border-primary-border bg-primary-bg px-3.5 py-2.5 text-primary shadow-xs transition focus:border-brand-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 data-error:border-error-border data-error:ring-error-500/25 dark:border-primary-border-dark dark:bg-primary-bg-dark dark:text-primary-dark dark:focus:border-brand-border-dark dark:data-error:border-error-border-dark"
                id="first-name"
                type="text"
              />
            </div>

            <div class="flex flex-col gap-1.5 lg:flex-1">
              <label
                class="text-sm font-medium text-secondary dark:text-secondary-dark"
                for="last-name"
              >
                Last name
              </label>
              <input
                class="rounded border border-primary-border bg-primary-bg px-3.5 py-2.5 text-primary shadow-xs transition focus:border-brand-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 data-error:border-error-border data-error:ring-error-500/25 dark:border-primary-border-dark dark:bg-primary-bg-dark dark:text-primary-dark dark:focus:border-brand-border-dark dark:data-error:border-error-border-dark"
                id="last-name"
                type="text"
              />
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label
              class="text-sm font-medium text-secondary dark:text-secondary-dark"
              for="address-1"
            >
              Address 1
            </label>
            <input
              class="rounded border border-primary-border bg-primary-bg px-3.5 py-2.5 text-primary shadow-xs transition focus:border-brand-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 data-error:border-error-border data-error:ring-error-500/25 dark:border-primary-border-dark dark:bg-primary-bg-dark dark:text-primary-dark dark:focus:border-brand-border-dark dark:data-error:border-error-border-dark"
              id="address-1"
              type="text"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label
              class="text-sm font-medium text-secondary dark:text-secondary-dark"
              for="address-2"
            >
              Address 2
            </label>
            <input
              class="rounded border border-primary-border bg-primary-bg px-3.5 py-2.5 text-primary shadow-xs transition focus:border-brand-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 data-error:border-error-border data-error:ring-error-500/25 dark:border-primary-border-dark dark:bg-primary-bg-dark dark:text-primary-dark dark:focus:border-brand-border-dark dark:data-error:border-error-border-dark"
              id="address-2"
              type="text"
            />
          </div>

          <div class="flex flex-col gap-6 lg:flex-row lg:gap-8">
            <div class="flex flex-col gap-1.5 lg:flex-1">
              <label class="text-sm font-medium text-secondary dark:text-secondary-dark" for="city">
                City
              </label>
              <input
                class="rounded border border-primary-border bg-primary-bg px-3.5 py-2.5 text-primary shadow-xs transition focus:border-brand-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 data-error:border-error-border data-error:ring-error-500/25 dark:border-primary-border-dark dark:bg-primary-bg-dark dark:text-primary-dark dark:focus:border-brand-border-dark dark:data-error:border-error-border-dark"
                id="city"
                type="text"
              />
            </div>

            <div class="flex flex-col gap-1.5 lg:flex-1">
              <label
                class="text-sm font-medium text-secondary dark:text-secondary-dark"
                for="country"
              >
                Country/Region
              </label>
              <select
                class="form-select rounded border border-primary-border bg-primary-bg px-3.5 py-2.5 text-primary shadow-xs transition focus:border-brand-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 data-error:border-error-border data-error:ring-error-500/25 dark:border-primary-border-dark dark:bg-primary-bg-dark dark:text-primary-dark dark:focus:border-brand-border-dark dark:data-error:border-error-border-dark"
                name=""
                id="country"
              >
                <option value="Philippines">Philippines</option>
              </select>
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label
              class="text-sm font-medium text-secondary dark:text-secondary-dark"
              for="zip-code"
            >
              ZIP Code
            </label>
            <input
              class="rounded border border-primary-border bg-primary-bg px-3.5 py-2.5 text-primary shadow-xs transition focus:border-brand-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 data-error:border-error-border data-error:ring-error-500/25 dark:border-primary-border-dark dark:bg-primary-bg-dark dark:text-primary-dark dark:focus:border-brand-border-dark dark:data-error:border-error-border-dark"
              id="zip-code"
              type="text"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label
              class="text-sm font-medium text-secondary dark:text-secondary-dark"
              for="phone-number"
            >
              Phone number
            </label>
            <input
              class="rounded border border-primary-border bg-primary-bg px-3.5 py-2.5 text-primary shadow-xs transition focus:border-brand-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 data-error:border-error-border data-error:ring-error-500/25 dark:border-primary-border-dark dark:bg-primary-bg-dark dark:text-primary-dark dark:focus:border-brand-border-dark dark:data-error:border-error-border-dark"
              id="phone-number"
              type="text"
            />
          </div>

          <button
            class="rounded bg-button-primary-bg px-4 py-2.5 font-semibold text-button-primary-fg shadow-xs transition hover:bg-button-primary-bg-hover focus:border-button-primary-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 dark:focus:border-button-primary-border-dark"
            type="submit"
          >
            Update address
          </button>
        </form>
      </main>
    </div>
  </div>
</Layout>
