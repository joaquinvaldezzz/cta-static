---
import Layout from '~/layouts/Layout.astro'
import BackgroundPatternCircles from '~/snippets/background-pattern-circles.astro'
import ArrowLeftIcon from '~/snippets/icon-arrow-left.astro'
import CheckIcon from '~/snippets/icon-check.astro'
import LockIcon from '~/snippets/icon-lock.astro'
---

<Layout title="Set new password">
  <div class="overflow-x-hidden py-12 md:pt-24">
    <div class="flex flex-col gap-8 px-4 sm:mx-auto sm:max-w-[360px] sm:px-0">
      <header class="flex flex-col items-center gap-6">
        <div class="relative">
          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
            <BackgroundPatternCircles />
          </div>
          <div
            class="flex h-14 w-14 items-center justify-center rounded-xl border border-light-200 shadow-xs dark:border-dark-700"
          >
            <LockIcon className="h-7 w-7 text-secondary-fg dark:text-secondary-fg-dark" />
          </div>
        </div>

        <div class="relative flex flex-col gap-2 text-center md:gap-3">
          <h1
            class="font-display text-display-xs font-semibold text-primary dark:text-primary-dark md:text-display-sm"
          >
            Set new password
          </h1>
          <p class="text-tertiary dark:text-tertiary-dark">
            Your new password must be different to previously used passwords.
          </p>
        </div>
      </header>

      <main class="relative flex flex-col gap-8">
        <form class="flex flex-col gap-6" action="">
          <div class="flex flex-col gap-1.5">
            <label
              class="text-sm font-medium text-secondary dark:text-secondary-dark"
              for="password"
            >
              New password
            </label>
            <input
              class="rounded border border-primary-border bg-primary-bg px-3.5 py-2.5 text-primary shadow-xs transition placeholder:text-placeholder focus:border-brand-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 dark:border-primary-border-dark dark:bg-primary-bg-dark dark:text-primary-dark dark:placeholder:text-placeholder-dark dark:focus:border-brand-border-dark"
              id="password"
              type="password"
              placeholder="Enter your new password"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label
              class="text-sm font-medium text-secondary dark:text-secondary-dark"
              for="confirm-password"
            >
              Confirm password
            </label>
            <input
              class="rounded border border-primary-border bg-primary-bg px-3.5 py-2.5 text-primary shadow-xs transition placeholder:text-placeholder focus:border-brand-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 dark:border-primary-border-dark dark:bg-primary-bg-dark dark:text-primary-dark dark:placeholder:text-placeholder-dark dark:focus:border-brand-border-dark"
              id="confirm-password"
              type="password"
              placeholder="Confirm your new password"
            />
          </div>

          <ul class="flex flex-col gap-3">
            <li class="flex gap-2" aria-label="Password are the same">
              <CheckIcon
                className="h-5 w-5 rounded-full text-disabled-fg-subtle transition data-status:text-success-primary-fg dark:text-disabled-fg-subtle-dark dark:data-status:text-success-primary-fg-dark"
                status="false"
              />
              <div class="text-sm text-tertiary dark:text-tertiary-dark">
                Passwords are the same
              </div>
            </li>

            <li class="flex gap-2" aria-label="Must be at least 8 characters">
              <CheckIcon
                className="h-5 w-5 rounded-full text-disabled-fg-subtle transition data-status:text-success-primary-fg dark:text-disabled-fg-subtle-dark dark:data-status:text-success-primary-fg-dark"
                status="false"
              />
              <div class="text-sm text-tertiary dark:text-tertiary-dark">
                Must be at least 8 characters
              </div>
            </li>

            <li class="flex gap-2" aria-label="Must contain one special character">
              <CheckIcon
                className="h-5 w-5 rounded-full text-disabled-fg-subtle transition data-status:text-success-primary-fg dark:text-disabled-fg-subtle-dark dark:data-status:text-success-primary-fg-dark"
                status="false"
              />
              <div class="text-sm text-tertiary dark:text-tertiary-dark">
                Must contain one special character
              </div>
            </li>
          </ul>

          <button
            class="rounded border border-button-primary-border bg-button-primary-bg px-4 py-2.5 font-semibold text-button-primary-fg shadow-xs transition hover:border-button-primary-border-hover hover:bg-button-primary-bg-hover focus:border-button-primary-border focus:outline-none focus:ring-4 focus:ring-brand-600/25 disabled:border-disabled-border-subtle disabled:bg-disabled-bg disabled:text-disabled-fg dark:focus:border-button-primary-border-dark"
            type="submit"
          >
            Reset password
          </button>
        </form>

        <div class="flex justify-center">
          <a
            class="inline-flex items-center justify-center gap-1.5 rounded text-button-tertiary-fg transition hover:text-button-tertiary-fg-hover focus:outline-none focus:outline-brand-600 dark:text-button-tertiary-fg-dark"
            href="#"
          >
            <ArrowLeftIcon className="h-5 w-5" />
            <span class="text-sm font-semibold">Back to log in</span>
          </a>
        </div>
      </main>
    </div>
  </div>

  <script src="../scripts/form.js"></script>
</Layout>
