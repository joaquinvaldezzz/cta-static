---
interface Props {
  className?: string
  status?: 'true' | 'false'
}

const { className, status } = Astro.props
---

<svg
  class={className}
  data-status={status}
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  viewBox="0 0 20 20"
>
  <path
    fill="currentColor"
    d="M0 10C0 4.477 4.477 0 10 0s10 4.477 10 10-4.477 10-10 10S0 15.523 0 10Z"></path>
  <path
    stroke="#fff"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    d="m6.25 10 2.5 2.5 5-5"></path>
</svg>
