---
import CompanyLogo from './CompanyLogo.astro'

const products = [
  {
    href: '#',
    text: 'Overview',
  },
  {
    href: '#',
    text: 'Features',
  },
  {
    href: '#',
    text: 'Solutions',
  },
  {
    href: '#',
    text: 'Tutorials',
  },
  {
    href: '#',
    text: 'Pricing',
  },
  {
    href: '#',
    text: 'Releases',
  },
]
---

<footer class="flex flex-col gap-12 bg-dark-950 py-12 lg:pt-16">
  <div class="grid max-w-screen-xl gap-12 px-4 md:px-8 lg:grid-cols-3 lg:gap-16">
    <div class="flex flex-col gap-6 lg:order-1">
      <CompanyLogo className="h-12 w-40" />
      <p class="text-dark-400">
        Design amazing digital experiences that create more happy in the world.
      </p>
    </div>

    <div class="flex flex-col gap-4 lg:order-4">
      <h2 class="text-sm font-semibold text-dark-50">Stay up to date</h2>
      <form class="flex flex-col gap-4 xl:flex-row" action="">
        <input
          class="rounded border border-dark-700 bg-dark-950 px-3.5 py-2.5 placeholder:text-dark-500"
          type="email"
          placeholder="Enter your email address"
        />
        <button class="rounded bg-brand-600 px-4 py-2.5 font-semibold text-white" type="submit">
          Subscribe
        </button>
      </form>
    </div>

    <div class="grid grid-cols-2 gap-8 lg:order-2">
      <div class="flex flex-col gap-4">
        <h2 class="text-sm font-semibold text-dark-50">Products</h2>
        <ul class="flex flex-col gap-3">
          {
            products.map((product) => (
              <li>
                <a class="font-semibold text-dark-300" href={product.href}>
                  {product.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col gap-4">
        <h2 class="text-sm font-semibold text-dark-50">Resources</h2>
        <ul class="flex flex-col gap-3">
          {
            products.map((product) => (
              <li>
                <a class="font-semibold text-dark-300" href={product.href}>
                  {product.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="flex flex-col gap-4 border-t border-dark-800 pt-8 lg:order-4 lg:col-span-3 lg:flex-row lg:gap-8"
    >
      <ul class="flex flex-wrap gap-x-4 gap-y-2 lg:order-2">
        {
          products.map((product) => (
            <li>
              <a class="text-dark-400" href={product.href}>
                {product.text}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="text-dark-400 lg:order-1">&copy; 2077 Untitled UI. All rights reserved.</p>
    </div>
  </div>
</footer>
